# Copy to .env.local — do NOT commit .env.local
# All VITE_ variables are embedded in the build bundle (visible to users).
# Never put secrets here.

# FastAPI backend URL (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Ethereum chain ID for MetaMask connection check (1337 = local Ganache)
VITE_CHAIN_ID=1337
