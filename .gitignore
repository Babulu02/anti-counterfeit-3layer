# Secrets - NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# Python Virtual Environments & Caches (Crucial: never push .venv)
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
.pytest_cache/
**/.pytest_cache/

# Node & Frontend Build Artefacts
node_modules/
**/node_modules/
dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Large ML model weights & data
*.pkl
*.joblib
!experiments/results/*.joblib

# Raw datasets & product images (Crucial: never push product-images or large raw CSVs)
data/product-images/
**/product-images/
data/scans.csv
data/*.csv
!data/README.md

# Truffle Build Artefacts (Keep ProductRegistry.json ABI for backend/frontend integration)
contracts/build/
!contracts/build/contracts/ProductRegistry.json
contracts/.truffle_db/

# Log files and archives
*_out.txt
*_err.txt
*.log
*.zip
*.tar.gz

# OS-specific
.DS_Store
Thumbs.db

# IDE configurations
.vscode/
.idea/
.kiro/
