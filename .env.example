# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Blockchain ─────────────────────────────────────────────────────────────
# Ganache RPC (local). Port 7545 matches both Ganache GUI default and our CLI script.
RPC_URL=http://127.0.0.1:7545

# Address of the deployed ProductRegistry contract (filled in after migration)
CONTRACT_ADDRESS=0xYourContractAddressHere

# Private key of the backend "operator" account (account[1] in Ganache).
# Used to call logScan() from the backend.
# Example Ganache key – replace with your own, never use on mainnet.
OPERATOR_PRIVATE_KEY=0xYourGanachePrivateKeyHere

# Private key of the "owner / deployer" account (account[0] in Ganache).
# Only needed for scripts that add manufacturers.
OWNER_PRIVATE_KEY=0xYourOwnerPrivateKeyHere

# ── Backend ─────────────────────────────────────────────────────────────────
# HMAC master secret for QR/NFC identity module (32+ random bytes, hex-encoded)
IDENTITY_HMAC_SECRET=change_this_to_a_random_hex_string_at_least_32_bytes_long

# AES-128 master key for NFC CMAC (32 hex chars = 16 bytes)
NFC_MASTER_KEY=0000000000000000000000000000000

# SQLite database path
DATABASE_URL=sqlite:///./backend/db.sqlite3

# ── ML ───────────────────────────────────────────────────────────────────────
# Path to saved model artefacts (relative to project root)
ML_MODEL_PATH=experiments/results/rf_model.joblib
ML_THRESHOLDS_PATH=experiments/results/thresholds.json
