# anti-counterfeit-3layer — environment template
# Copy to .env and fill in real values. NEVER commit .env.

# ── Database (MySQL via PyMySQL) ─────────────────────────────────────────────
# The URL is built with sqlalchemy.engine.URL.create from these parts,
# so special characters in passwords are handled safely.
DB_USER=ac_user
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=anticounterfeit
TEST_DB_NAME=anticounterfeit_test

# ── Blockchain ────────────────────────────────────────────────────────────────
# Start Ganache: ganache --port 7546 --deterministic --accounts 10 --networkId 1337
RPC_URL=http://127.0.0.1:7546

# Deployed by: cd contracts && truffle migrate --network cli --reset
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Ganache deterministic account[0] — owner / deployer (never used at runtime)
OWNER_PRIVATE_KEY=0xYourOwnerPrivateKey

# Ganache deterministic account[1] — backend operator (calls logScan, markSold)
OPERATOR_PRIVATE_KEY=0xYourOperatorPrivateKey

# Ganache deterministic account[2] — used by seed script for manufacturer txns
MANUFACTURER_PRIVATE_KEY=0xYourManufacturerPrivateKey

# ── Identity secrets ─────────────────────────────────────────────────────────
# 32-byte hex string (no 0x), used as HMAC key for QR signatures
IDENTITY_HMAC_SECRET=replace_with_64_random_hex_characters

# AES-128 master key for NFC CMAC — exactly 32 hex chars (16 bytes), no 0x
NFC_MASTER_KEY=replace_with_32_random_hex_characters

# ── ML artefacts ──────────────────────────────────────────────────────────────
ML_MODEL_PATH=experiments/results/rf_model.joblib
ML_THRESHOLDS_PATH=experiments/results/thresholds.json
